# ==============================================================================
# Mark Davis Portfolio - Environment Variables Template
# Copy this file to .env.local and fill in your real credentials
# ==============================================================================

# 1. MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# 2. Cloudinary Media Upload & Storage
# Get these from https://console.cloudinary.com/
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 3. Telegram Bot Notifications (Instant Contact Inquiries)
# TELEGRAM_BOT_TOKEN: Obtained from @BotFather on Telegram
# TELEGRAM_CHAT_ID: Obtained from @userinfobot or @getidsbot on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# 4. NextAuth Configuration & Admin Credentials
# NEXTAUTH_URL: http://localhost:3000 (local) or https://your-domain.vercel.app (production)
# NEXTAUTH_SECRET: Generate a 32+ character random string (e.g. openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key
ADMIN_EMAIL=admin@markdavis.design
ADMIN_PASSWORD=your_secure_admin_password
